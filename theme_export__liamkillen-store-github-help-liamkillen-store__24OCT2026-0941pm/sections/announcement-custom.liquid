{{ 'section-announcement-custom.css' | asset_url | stylesheet_tag }}

{% style %}
  .announcement-bar-wrapper-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url }}');
      background-size: {{ section.settings.background_size }};
      background-position: {{ section.settings.background_position }};
      background-repeat: {{ section.settings.background_repeat }};
    {% endif %}
    color: {{ section.settings.text_color }};
    height: {{ section.settings.bar_height }}px;
  }
  
  .announcement-bar-wrapper-{{ section.id }} .announcement-marquee {
    animation-duration: {{ section.settings.scroll_speed }}s;
  }
{% endstyle %}

<div class="announcement-bar-wrapper announcement-bar-wrapper-{{ section.id }}">
  <div class="announcement-bar">
    <div class="announcement-marquee-container">
      <div class="announcement-marquee">
        {% for block in section.blocks %}
          <div class="announcement-item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="announcement-link">
            {% endif %}
            
            {% if block.settings.icon != blank %}
              <span class="announcement-icon">{{ block.settings.icon }}</span>
            {% endif %}
            
            <span class="announcement-text">{{ block.settings.text }}</span>
            
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
            
            <span class="announcement-separator">{{ section.settings.separator }}</span>
          </div>
        {% endfor %}
      </div>
      
      <!-- Duplicate for seamless loop -->
      <div class="announcement-marquee" aria-hidden="true">
        {% for block in section.blocks %}
          <div class="announcement-item">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="announcement-link">
            {% endif %}
            
            {% if block.settings.icon != blank %}
              <span class="announcement-icon">{{ block.settings.icon }}</span>
            {% endif %}
            
            <span class="announcement-text">{{ block.settings.text }}</span>
            
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
            
            <span class="announcement-separator">{{ section.settings.separator }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "header",
      "content": "Background Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Optional: Add a background image"
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background Image Size",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "auto",
          "label": "Original"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background Image Position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background_repeat",
      "label": "Background Repeat",
      "options": [
        {
          "value": "no-repeat",
          "label": "No Repeat"
        },
        {
          "value": "repeat",
          "label": "Repeat"
        },
        {
          "value": "repeat-x",
          "label": "Repeat Horizontally"
        }
      ],
      "default": "no-repeat"
    },
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator Between Announcements",
      "default": "•",
      "info": "Use symbols like • | ★ or emoji"
    },
    {
      "type": "header",
      "content": "Scroll Settings"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Scroll Speed",
      "info": "Lower = faster, Higher = slower",
      "default": 30
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "bar_height",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bar Height",
      "default": 45
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Welcome to our store!"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or symbol)",
          "info": "Optional: Add an emoji or symbol before the text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional: Make the announcement clickable"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free shipping on orders over $50!",
            "icon": "🚚"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "New arrivals now in stock!",
            "icon": "✨"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Shop now and save up to 30%",
            "icon": "🎉"
          }
        }
      ]
    }
  ]
}
{% endschema %}