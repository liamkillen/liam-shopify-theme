<div class="custom-video-grid-section">
  <style>
    .custom-video-grid-section {
      background: {{ section.settings.background_color }};
      padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
    }

    .custom-video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax({{ section.settings.min_column_width }}px, 1fr));
      gap: {{ section.settings.gap_desktop }}rem;
      margin: 0 auto;
      padding: 0 {{ section.settings.horizontal_padding }}rem;
      max-width: {{ section.settings.max_width }}px;
    }

    .custom-video-wrapper {
      position: relative;
      width: 100%;
      padding-bottom: 177.78%; /* 9:16 aspect ratio */
      height: 0;
      border-radius: {{ section.settings.border_radius }}px;
      overflow: hidden;
    }

    .custom-video-wrapper video,
    .custom-video-wrapper iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
      object-fit: cover;
    }

    .custom-video-player {
      background: #000;
    }

    /* Section heading */
    .custom-video-grid-heading {
      text-align: {{ section.settings.heading_alignment }};
      margin-bottom: {{ section.settings.heading_spacing }}px;
      padding: 0 {{ section.settings.horizontal_padding }}rem;
      max-width: {{ section.settings.max_width }}px;
      margin-left: auto;
      margin-right: auto;
    }

    .custom-video-grid-heading h2 {
      font-size: {{ section.settings.heading_size }}px;
      color: {{ section.settings.heading_color }};
      margin: 0;
    }

    /* For small screens (less than 800px), use 2 videos per row */
    @media (max-width: 800px) {
      .custom-video-grid {
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
        gap: {{ section.settings.gap_mobile }}rem;
      }

      .custom-video-grid-section {
        padding: {{ section.settings.section_padding_top_mobile }}px 0 {{ section.settings.section_padding_bottom_mobile }}px 0;
      }

      .custom-video-grid-heading h2 {
        font-size: {{ section.settings.heading_size_mobile }}px;
      }
    }

    /* For medium screens (800px - 1200px), limit to 2 videos per row */
    @media (max-width: 1200px) and (min-width: 800px) {
      .custom-video-grid {
        grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
      }
    }

    /* For large screens (1200px and up), use specified number of videos per row */
    @media (min-width: 1200px) {
      .custom-video-grid {
        grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
      }
    }
  </style>

  {% comment %}Get the currently selected variant or first variant{% endcomment %}
  {% if product.selected_or_first_available_variant %}
    {% assign current_variant = product.selected_or_first_available_variant %}
  {% else %}
    {% assign current_variant = product.variants.first %}
  {% endif %}

  {% comment %}Get video previews from variant metafield{% endcomment %}
  {% assign video_previews = current_variant.metafields.custom.video_previews.value %}

  {% if video_previews != blank %}
    {% if section.settings.heading != blank %}
      <div class="custom-video-grid-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="custom-video-grid">
      {% for video in video_previews %}
        {% if video != blank %}
          {% comment %}Try to get URL from sources array first{% endcomment %}
          {% assign video_url = '' %}

          {% if video.sources and video.sources.size > 0 %}
            {% assign video_url = video.sources[0].url %}
          {% else %}
            {% assign video_file_url = video | file_url %}
            {% if video_file_url contains '//' %}
              {% assign video_url = 'https:' | append: video_file_url %}
            {% else %}
              {% assign video_url = video_file_url %}
            {% endif %}
          {% endif %}

          {% if video_url != blank %}
            <div class="custom-video-wrapper">
              <video
                class="custom-video-player"
                {% if section.settings.video_controls %}controls{% endif %}
                {% if section.settings.video_autoplay %}autoplay{% endif %}
                {% if section.settings.video_muted %}muted{% endif %}
                {% if section.settings.video_loop %}loop{% endif %}
                playsinline
                preload="metadata">
                <source src="{{ video_url }}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    {% comment %}Show message if no videos are available{% endcomment %}
    {% if section.settings.show_no_videos_message %}
      <div class="custom-video-grid-heading">
        <p style="text-align: center; color: {{ section.settings.heading_color }};">{{ section.settings.no_videos_message }}</p>
      </div>
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom Video Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Video Gallery"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns (tablet)",
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "min_column_width",
      "min": 150,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Minimum column width",
      "default": 200
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "label": "Maximum container width",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 0,
      "max": 6,
      "step": 0.5,
      "unit": "rem",
      "label": "Gap between videos (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 4,
      "step": 0.5,
      "unit": "rem",
      "label": "Gap between videos (mobile)",
      "default": 2
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "min": 0,
      "max": 6,
      "step": 0.5,
      "unit": "rem",
      "label": "Horizontal padding",
      "default": 2
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Section top padding (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Section bottom padding (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Section top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Section bottom padding (mobile)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Video corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show video controls",
      "default": true,
      "info": "Display play/pause, volume, and progress controls"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay videos",
      "default": false,
      "info": "Videos must be muted to autoplay in most browsers"
    },
    {
      "type": "checkbox",
      "id": "video_muted",
      "label": "Mute videos by default",
      "default": true,
      "info": "Required for autoplay to work"
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Loop videos",
      "default": false,
      "info": "Restart video when it ends"
    },
    {
      "type": "header",
      "content": "Empty State"
    },
    {
      "type": "checkbox",
      "id": "show_no_videos_message",
      "label": "Show message when no videos available",
      "default": false
    },
    {
      "type": "text",
      "id": "no_videos_message",
      "label": "No videos message",
      "default": "No video previews available for this product."
    }
  ],
  "presets": [
    {
      "name": "Custom Video Grid",
      "category": "Video"
    }
  ]
}
{% endschema %}
