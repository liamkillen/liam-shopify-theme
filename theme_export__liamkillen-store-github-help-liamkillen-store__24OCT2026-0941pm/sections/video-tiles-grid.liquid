{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-modal-video.css' | asset_url | stylesheet_tag }}
{{ 'video-tiles-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign video_id = section.settings.video.id | default: section.settings.video_url.id
  assign video_alt = section.settings.video.alt | default: section.settings.video_description
  assign alt = 'sections.video.load_video' | t: description: video_alt | escape
  assign poster = section.settings.video.preview_image | default: section.settings.cover_image
-%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="vtg-grid">
      <div class="vtg-item vtg-item--video">
        <div class="vtg-video">
          {%- if section.settings.video == null and section.settings.video_url != null -%}
            {%- liquid
              assign yt_loop = ''
              if section.settings.video_url.type == 'youtube' and section.settings.loop
                assign yt_loop = '&loop=1&playlist=' | append: video_id
              endif
            -%}
            {%- if section.settings.video_url.type == 'youtube' -%}
              <iframe
                src="https://www.youtube.com/embed/{{ video_id }}?playsinline=1&autoplay={{ section.settings.autoplay | default: true | json }}&mute={{ section.settings.muted | default: true | json }}&controls={{ section.settings.show_controls | default: true | json }}&rel=0&modestbranding=1{{ yt_loop }}"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                title="{{ section.settings.video_description | escape }}"
              ></iframe>
            {%- else -%}
              <iframe
                src="https://player.vimeo.com/video/{{ video_id }}?autoplay={{ section.settings.autoplay | default: true | json }}&muted={{ section.settings.muted | default: true | json }}&loop={{ section.settings.loop | default: true | json }}&controls={{ section.settings.show_controls | default: true | json }}&title=0&byline=0&portrait=0&playsinline=1"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                title="{{ section.settings.video_description | escape }}"
              ></iframe>
            {%- endif -%}
          {%- else -%}
            {{ section.settings.video | video_tag: image_size: '1100x', autoplay: section.settings.autoplay, loop: section.settings.loop, controls: section.settings.show_controls, muted: section.settings.muted, playsinline: true }}
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <a class="vtg-item vtg-item--tile color-{{ block.settings.color_scheme }} gradient" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="vtg-card card-wrapper product-card-wrapper">
            <div class="media ratio" style="--ratio-percent: {% if forloop.index == 3 %}56.25{% else %}100{% endif %}%">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 2200 | image_tag: widths: '550, 720, 990, 1100, 1500, 2200', loading: 'lazy', alt: block.settings.heading | escape }}
              {%- else -%}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- if block.settings.heading != blank -%}
              <div class="vtg-overlay">
                <h3 class="vtg-title">{{ block.settings.heading }}</h3>
              </div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video + Tiles Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": true },
    { "type": "checkbox", "id": "muted", "label": "Muted", "default": true },
    { "type": "checkbox", "id": "show_controls", "label": "Show controls", "default": true },
    { "type": "video", "id": "video", "label": "Shopify hosted video" },
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "External video URL", "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc" },
    { "type": "image_picker", "id": "cover_image", "label": "Video cover image" },
    { "type": "text", "id": "video_description", "label": "Video description" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colors", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 36 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color_scheme", "id": "color_scheme", "label": "Overlay color scheme", "default": "scheme-1" }
      ]
    }
  ],
  "presets": [
    { "name": "Video + tiles grid", "blocks": [ {"type": "tile"}, {"type": "tile"}, {"type": "tile"} ] }
  ]
}
{% endschema %}


