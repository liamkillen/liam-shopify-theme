<div id="shopify-section-featured-top-products" class="shopify-section">
  <style>
    .featured-top-container {
      background: {{ section.settings.background_color }};
      padding: 60px;
    }

    .featured-top-wrapper {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }

    /* Featured Products - Left Side */
    .featured-products-side {
      display: flex;
      flex-direction: column;
    }

    .featured-products-side h2 {
      font-size: 48px;
      font-weight: 700;
      margin: 0 0 40px 0;
      text-align: left;
      color: #fff; 
    }

    .featured-product-card {
      margin-bottom: 40px;
      display: flex;
      flex-direction: column;
    }

    .featured-product-card > a {
      display: block;
      transition: opacity 0.2s ease;
    }

    .featured-product-card > a:hover {
      opacity: 0.9;
    }

    .featured-product-card > a > img,
    .featured-product-card > img {
      width: 100%;
      height: auto;
      display: block;
    }

    .featured-product-info {
      background: #3d3d3d;
      padding: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .featured-product-footer {
      background: #3d3d3d;
      padding: 10px 20px;
    }

    .featured-product-info h3 {
      font-size: 20px;
      font-weight: 400;
      margin: 0;
      color: #ffffff;
    }

    .featured-product-info .price {
      font-size: 16px;
      color: #ffffff;
    }

    .featured-product-info .view-link {
      color: #ffffff;
      text-decoration: underline;
      font-size: 16px;
    }

    .featured-player-container {
      display: flex;
      align-items: center;
      margin-top: 10px;
    }

    .featured-play-button {
      width: 40px;
      height: 40px;
      cursor: pointer;
      margin-right: 10px;
    }

    .featured-waveform {
      flex: 1;
      height: 40px;
      display: block !important;
    }

    .featured-waveform > div {
      width: 100% !important;
      height: 40px !important;
      display: block !important;
    }

    .featured-waveform canvas {
      width: 100% !important;
      height: 40px !important;
      display: block !important;
    }

    div.featured-waveform:empty {
      display: block !important;
    }

    /* Top Products - Right Side */
    .top-products-side {
      display: flex;
      flex-direction: column;
    }

    .top-products-side h2 {
      font-size: 48px;
      font-weight: 700;
      margin: 0 0 40px 0;
      text-align: left;
      color: #ffffff;
    }

    .top-product-item {
      display: grid;
      grid-template-columns: 60px 120px 1fr;
      gap: 20px;
      align-items: center;
      margin-bottom: 20px;
      background: #3d3d3d;
      padding: 15px;
    }

    .top-rank {
      font-size: 48px;
      font-weight: 700;
      color: #ffffff;
      text-align: center;
    }

    .top-product-item > a {
      display: block;
      transition: opacity 0.2s ease;
    }

    .top-product-item > a:hover {
      opacity: 0.9;
    }

    .top-product-image {
      width: 120px;
      height: 120px;
      object-fit: cover;
      display: block;
    }

    .top-product-details {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .top-product-details h3 {
      font-size: 16px;
      margin: 0 0 10px 0;
      color: #ffffff;
    }

    .top-product-details .price {
      font-size: 14px;
      color: #ffffff;
      margin-bottom: 10px;
    }

    .top-product-details .sale-badge {
      background: #ff0000;
      color: #ffffff;
      padding: 4px 12px;
      font-size: 12px;
      font-weight: 600;
      border-radius: 20px;
      display: inline-block;
      margin-bottom: 10px;
      width: fit-content;
    }

    .top-product-details .view-link {
      color: #ffffff;
      text-decoration: underline;
      font-size: 14px;
      margin-top: 5px;
    }

    .top-player-container {
      display: flex;
      align-items: center;
      margin-top: 10px;
    }

    .top-play-button {
      width: 30px;
      height: 30px;
      cursor: pointer;
      margin-right: 10px;
    }

    .top-waveform {
      flex: 1;
      height: 30px;
      display: block !important;
    }

    .top-waveform > div {
      width: 100% !important;
      height: 20px !important;
      display: block !important;
    }

    .top-waveform canvas {
      width: 100% !important;
      height: 30px !important;
      display: block !important;
    }

    div.top-waveform:empty {
      display: block !important;
    }

    @media only screen and (max-width: 1024px) {
      .featured-top-wrapper {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .featured-top-container {
        padding: 40px 20px;
      }
    }

    @media only screen and (max-width: 768px) {
      .featured-products-side h2,
      .top-products-side h2 {
        font-size: 32px;
        margin: 0 0 30px 0;
      }

      .top-product-item {
        grid-template-columns: 50px 100px 1fr;
        gap: 15px;
        padding: 12px;
        margin-bottom: 15px;
      }

      .top-rank {
        font-size: 36px;
      }

      .top-product-image {
        width: 100px;
        height: 100px;
      }

      .top-product-details h3 {
        font-size: 15px;
        line-height: 1.3;
      }

      .top-product-details .price {
        font-size: 13px;
      }

      .top-product-details .sale-badge {
        font-size: 11px;
        padding: 3px 10px;
      }

      .top-product-details .view-link {
        font-size: 13px;
      }

      .top-play-button {
        width: 26px;
        height: 26px;
        margin-right: 8px;
      }

      .top-waveform {
        height: 26px;
      }

      .top-waveform > div {
        height: 26px !important;
      }

      .top-waveform canvas {
        height: 26px !important;
      }
    }

    @media only screen and (max-width: 480px) {
      .featured-products-side h2,
      .top-products-side h2 {
        font-size: 28px;
        margin: 0 0 24px 0;
      }

      .top-product-item {
        grid-template-columns: 40px 80px 1fr;
        gap: 10px;
        padding: 10px;
      }

      .top-rank {
        font-size: 28px;
      }

      .top-product-image {
        width: 80px;
        height: 80px;
      }

      .top-product-details h3 {
        font-size: 14px;
      }

      .top-product-details .price {
        font-size: 12px;
      }

      .top-product-details .view-link {
        font-size: 12px;
      }

      .featured-top-container {
        padding: 30px 16px;
      }
    }
  </style>

  <section class="featured-top-container">
    <div class="featured-top-wrapper">

      <!-- Featured Products - Left Side -->
      <div class="featured-products-side">
        <h2>{{ section.settings.featured_title }}</h2>

        {% for block in section.blocks %}
          {% if block.type == 'featured_product' %}
            {% assign product = block.settings.product %}
            {% if product != blank %}
              {% comment %}Use custom link if provided, otherwise use product URL{% endcomment %}
              {% assign product_link = block.settings.custom_link | default: product.url %}
              
              <div class="featured-product-card">
                {% if product.featured_image %}
                  <a href="{{ product_link }}">
                    <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}">
                  </a>
                {% endif %}

                <div class="featured-product-info">
                  <div>
                    <h3>{{ product.title }}</h3>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                    {% if product.compare_at_price > product.price %}
                      <p class="price">
                        <span style="color: #ff0000;">{{ product.price | money }}</span>
                        <span style="text-decoration: line-through; margin-left: 10px;">{{ product.compare_at_price | money }}</span>
                      </p>
                    {% else %}
                      <p class="price">{{ product.price | money }}</p>
                    {% endif %}
                    </div>
                    <div>
                    <a href="{{ product_link }}" class="view-link">View Product</a>
                  </div>
                  </div>
                </div>
                </div>

                {% comment %}Audio player if metafield exists (custom.mainpreview){% endcomment %}
                {% if block.settings.show_preview %}
                  {% assign variant = product.selected_or_first_available_variant | default: product.variants.first %}
                  {% assign mainpreview = variant.metafields.custom.mainpreview | default: product.metafields.custom.mainpreview %}
                  {% if mainpreview %}
                    <div class="featured-product-footer">
                      <div class="featured-player-container">
                        <img
                          id="featuredPlayButton{{ forloop.index }}"
                          class="featured-play-button"
                          src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129"
                          alt="Play button">
                        <div id="featuredWaveform{{ forloop.index }}" class="featured-waveform" data-url="{{ mainpreview | file_url | default: mainpreview.value.url | default: mainpreview.value | default: mainpreview.url }}"><!-- waveform --></div>
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>

      <!-- Top Products - Right Side -->
      <div class="top-products-side">
        <h2>{{ section.settings.top_title }}</h2>

        {% for block in section.blocks %}
          {% if block.type == 'top_product' %}
            {% assign product = block.settings.product %}
            {% if product != blank %}
              {% comment %}Use custom link if provided, otherwise use product URL{% endcomment %}
              {% assign product_link = block.settings.custom_link | default: product.url %}
              
              <div class="top-product-item">
                <div class="top-rank">{{ forloop.index }}</div>

                {% if product.featured_image %}
                  <a href="{{ product_link }}">
                    <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title }}" class="top-product-image">
                  </a>
                {% endif %}

                <div class="top-product-details">
                  {% if block.settings.show_sale_badge %}
                    <span class="sale-badge">On sale</span>
                  {% endif %}

                  <h3>{{ product.title }}</h3>
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                    {% if product.compare_at_price > product.price %}
                      <p class="price">
                        <span style="color: #ff0000;">{{ product.price | money }}</span>
                        <span style="text-decoration: line-through; margin-left: 10px;">{{ product.compare_at_price | money }}</span>
                      </p>
                    {% else %}
                      <p class="price">{{ product.price | money }}</p>
                    {% endif %}
                    </div>
                    <div>
                    <a href="{{ product_link }}" class="view-link">View Product</a>
                    </div>
                  </div>
                  {% comment %}Audio player if metafield exists (custom.mainpreview){% endcomment %}
                  {% if block.settings.show_preview %}
                    {% assign variant = product.selected_or_first_available_variant | default: product.variants.first %}
                    {% assign mainpreview = variant.metafields.custom.mainpreview | default: product.metafields.custom.mainpreview %}
                    {% if mainpreview %}
                      <div class="top-player-container">
                        <img
                          id="topPlayButton{{ forloop.index }}"
                          class="top-play-button"
                          src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129"
                          alt="Play button">
                        <div id="topWaveform{{ forloop.index }}" class="top-waveform" data-url="{{ mainpreview | file_url | default: mainpreview.value.url | default: mainpreview.value | default: mainpreview.url }}"><!-- waveform --></div>
                      </div>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </section>

  <script type="module">
    import WaveSurfer from 'https://unpkg.com/wavesurfer.js@7/dist/wavesurfer.esm.js'

    function initializeWavesurfers() {
      const instances = [];

      function initWave(container, options) {
        const url = container && container.dataset ? container.dataset.url : null;
        if (!url) {
          console.warn('Waveform container missing data-url', container);
          return;
        }

        try {
          const wavesurfer = WaveSurfer.create({
            container: container,
            waveColor: '#D6D9DF',
            progressColor: '#9F96A6',
            cursorWidth: 0,
            barWidth: 2,
            barGap: 1,
            barRadius: 2,
            normalize: true,
            ...options,
          });

          instances.push(wavesurfer);

          const parent = container.closest('.featured-player-container, .top-player-container');
          const playButton = parent ? parent.querySelector('.featured-play-button, .top-play-button') : null;

          if (playButton) {
            playButton.addEventListener('click', function () {
              instances.forEach(ws => {
                if (ws !== wavesurfer) {
                  ws.pause();
                }
              });
              wavesurfer.playPause();
            });
          }

          wavesurfer.on('play', function () {
            if (playButton) {
              playButton.src = 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/pause_white.png?v=1758032566';
            }
          });

          wavesurfer.on('pause', function () {
            if (playButton) {
              playButton.src = 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129';
            }
          });

          // Ensure absolute file URLs from Shopify metafields
          const resolvedUrl = url.startsWith('http') ? url : `${url}`;
          wavesurfer.load(resolvedUrl);
        } catch (error) {
          console.error('Failed to create wavesurfer:', error);
        }
      }

      document.querySelectorAll('.featured-waveform').forEach(container => {
        initWave(container, { height: 40 });
      });

      document.querySelectorAll('.top-waveform').forEach(container => {
        initWave(container, { height: 30 });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeWavesurfers);
    } else {
      initializeWavesurfers();
    }
  </script>
</div>

{% schema %}
{
  "name": "Featured & Top Products",
  "settings": [
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured Products Title",
      "default": "Latest Products"
    },
    {
      "type": "text",
      "id": "top_title",
      "label": "Top Products Title",
      "default": "Top 10 Bestselling Chart"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#e5e5e5"
    }
  ],
  "blocks": [
    {
      "type": "featured_product",
      "name": "Featured Product",
      "limit": 2,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link (optional)",
          "info": "Leave empty to use the default product page link"
        },
        {
          "type": "checkbox",
          "id": "show_preview",
          "label": "Show Audio Preview",
          "default": true,
          "info": "Displays audio preview if product has custom.mainpreview metafield"
        }
      ]
    },
    {
      "type": "top_product",
      "name": "Top Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom Link (optional)",
          "info": "Leave empty to use the default product page link"
        },
        {
          "type": "checkbox",
          "id": "show_preview",
          "label": "Show Audio Preview",
          "default": true,
          "info": "Displays audio preview if product has custom.mainpreview metafield"
        },
        {
          "type": "checkbox",
          "id": "show_sale_badge",
          "label": "Show 'On Sale' Badge",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured & Top Products",
      "category": "Custom"
    }
  ]
}
{% endschema %}