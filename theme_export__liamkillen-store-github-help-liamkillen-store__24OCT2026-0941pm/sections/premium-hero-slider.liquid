{%- comment -%}
  Premium Hero Slider (per-slide overlays)
  - Each slide can set: overlay mode (gradient / solid / none), gradient colors/angle, and a fallback background image
  - Centered "graphic" card shows VIDEO; if no video, shows the slide's graphic image
  - Keeps Dawn slideshow behavior, controls, and text content
  - ADDED: Each slide can now be clickable with a custom link using an overlay approach
{%- endcomment -%}

{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.graphic_image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.graphic_image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
    @media screen and (min-width: 750px) {
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.graphic_image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

<style>
  /* Ensure slides are positioning contexts so the backdrop pins correctly */
  .premium-hero__slider { position: relative; }
  .premium-hero__slider .slider__slide {
    position: relative;
    height: 100%;
    min-height: inherit;
  }

  /* LAYERING & LAYOUT */
  .premium-hero { position: relative; }
  .premium-hero__backdrop {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    z-index: 0;
    pointer-events: none;
  }
  .premium-hero__stage {
    position: relative; z-index: 1;
    display: grid; place-items: center;
    min-height: 100%;
    padding: var(--stage-padding-m, 24px);
    pointer-events: none;
  }
  @media (min-width: 750px) {
    .premium-hero__stage { padding: var(--stage-padding-d, 48px); }
  }

  /* THE "CARD" THAT CONTAINS THE VIDEO/IMAGE */
  .premium-hero__graphic {
    width: min(var(--graphic-w-m, 92%), var(--graphic-max, 1100px));
    aspect-ratio: var(--graphic-aspect, 16/9);
    border-radius: var(--graphic-radius, 20px);
    overflow: hidden;
    box-shadow: 0 10px 35px rgba(0,0,0,.35);
    position: relative;
    transition: transform 0.3s ease;
    pointer-events: none;
  }
  @media (min-width: 750px) {
    .premium-hero__graphic { width: min(var(--graphic-w-d, 70%), var(--graphic-max, 1100px)); }
  }

  /* MEDIA INSIDE THE CARD */
  .premium-hero__video,
  .premium-hero__image,
  .premium-hero__media--video video {
    width: 100%; height: 100%; object-fit: cover; display: block;
    pointer-events: none;
  }

  /* Slide link overlay - sits on top but below controls and content */
  .premium-hero__slide-link {
    position: absolute;
    inset: 0;
    display: block !important; /* Override base.css a:empty { display: none; } */
    text-decoration: none;
    color: inherit;
    background: transparent;
    border: none;
    z-index: 2;
    cursor: pointer;
  }

  /* When link is present, add hover effect to graphic */
  .premium-hero__graphic--clickable {
    transition: transform 0.3s ease;
  }

  .premium-hero__graphic--clickable:hover {
    transform: scale(1.02);
  }

  /* Video controls need to be above the link */
  .premium-hero__video[controls] {
    position: relative;
    z-index: 3;
    pointer-events: auto;
  }

  /* Controls and text above everything, including the slide link */
  .premium-hero__controls,
  .banner__content {
    position: relative;
    z-index: 4;
    pointer-events: auto;
  }
  
  /* Ensure buttons and links within content are clickable */
  .banner__content a,
  .banner__content button,
  .premium-hero__controls button { pointer-events: auto; }

  /* Optional subtle edge */
  .premium-hero__graphic::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
    z-index: 0;
  }

  /* Badge */
  .premium-hero__badge {
    position: absolute; top: 50%; left: 0;
    transform: translate(-50%, -50%) rotate(-90deg);
    transform-origin: center;
    background: var(--color-background, #ffffff);
    color: var(--color-foreground, #111);
    border: 1px solid rgba(0,0,0,.1);
    border-radius: 999px;
    padding: 8px 14px;
    display: flex; align-items: center; gap: 10px;
    z-index: 4;
    pointer-events: auto;
  }
  .premium-hero__badge span { font-weight: 600; white-space: nowrap; }
  .premium-hero__badge-close { background: transparent; border: 0; font-size: 16px; line-height: 1; cursor: pointer; pointer-events: auto; }
  @media (max-width: 749px) { .premium-hero__badge { display: none; } }

  .premium-hero__controls { position: absolute; bottom: 1rem; right: 1rem; left: 1rem; }

  /* Mobile optimizations - remove excessive spacing */
  @media screen and (max-width: 749px) {
    /* Override default banner min-heights on mobile for premium hero */
    .premium-hero__slider.banner--small:not(.banner--adapt),
    .premium-hero__slider.banner--medium:not(.banner--adapt),
    .premium-hero__slider.banner--large:not(.banner--adapt) {
      min-height: auto;
    }

    /* Remove min-height from banner content on mobile */
    .premium-hero__slider.banner--small:not(.banner--mobile-bottom):not(.banner--adapt) .banner__content,
    .premium-hero__slider.banner--medium:not(.banner--mobile-bottom):not(.banner--adapt) .banner__content,
    .premium-hero__slider.banner--large:not(.banner--mobile-bottom):not(.banner--adapt) .banner__content {
      min-height: auto;
    }

    /* Let slides adapt to content height on mobile */
    .premium-hero__slider .slider__slide {
      min-height: auto;
    }

    /* Reduce stage padding on mobile for tighter layout */
    .premium-hero__stage {
      padding: var(--stage-padding-m, 16px);
    }

    /* Reduce content padding on mobile */
    .premium-hero__content.banner__content {
      padding: 2rem 0;
    }

    /* Adjust banner box padding for tighter mobile layout */
    .premium-hero__slider .banner__box {
      padding: 2rem 1.5rem;
    }
  }
</style>

<slideshow-component
  id="Hero-{{ section.id }}"
  class="premium-hero slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}{% if section.settings.show_text_below %} mobile-text-below{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
  style="
    --graphic-w-d: {{ section.settings.graphic_width_desktop }}%;
    --graphic-w-m: {{ section.settings.graphic_width_mobile }}%;
    --graphic-max: {{ section.settings.graphic_max_width }}px;
    --graphic-radius: {{ section.settings.graphic_radius }}px;
    --stage-padding-d: {{ section.settings.stage_padding_desktop }}px;
    --stage-padding-m: {{ section.settings.stage_padding_mobile }}px;
    --graphic-aspect: {{ section.settings.graphic_aspect_ratio }};
  "
>
  {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
    <div class="premium-hero__badge">
      <span>{{ section.settings.badge_text }}</span>
      <button class="premium-hero__badge-close" aria-label="Close badge" data-badge-close>&times;</button>
    </div>
  {%- endif -%}

  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    <div class="slideshow__controls slideshow__controls--top premium-hero__controls slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}" aria-controls="Slider-{{ section.id }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}" aria-controls="Slider-{{ section.id }}">
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}" aria-controls="Slider-{{ section.id }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
      {%- if section.settings.auto_rotate -%}
        <button type="button" class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}" aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}">
          <span class="svg-wrapper">{{- 'icon-pause.svg' | inline_asset_content -}}</span>
          <span class="svg-wrapper">{{- 'icon-play.svg' | inline_asset_content -}}</span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div
    class="slideshow premium-hero__slider banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.settings.show_text_below %} banner--mobile-bottom{% endif %}{% if section.blocks.first.settings.graphic_image == blank and section.blocks.first.settings.video == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      {%- comment -%} Build per-slide overlay + background image {%- endcomment -%}
      {%- liquid
        assign overlay_css = ''
        if block.settings.overlay_mode == 'gradient'
          assign overlay_css = 'linear-gradient('
          assign overlay_css = overlay_css | append: block.settings.gradient_angle | append: 'deg, '
          assign overlay_css = overlay_css | append: block.settings.gradient_from | append: ', '
          assign overlay_css = overlay_css | append: block.settings.gradient_to | append: ')'
        elsif block.settings.overlay_mode == 'solid'
          assign overlay_css = 'linear-gradient(0deg, ' | append: block.settings.overlay_color | append: ', ' | append: block.settings.overlay_color | append: ')'
        endif

        assign image_url = ''
        if block.settings.background_image != blank
          assign image_url = block.settings.background_image | image_url: width: 3840
        elsif block.settings.graphic_image != blank
          assign image_url = block.settings.graphic_image | image_url: width: 3840
        elsif section.settings.section_fallback_image != blank
          assign image_url = section.settings.section_fallback_image | image_url: width: 3840
        endif

        assign bg_image_value = ''
        if overlay_css != '' and image_url != ''
          assign bg_image_value = overlay_css | append: ', url(' | append: image_url | append: ')'
        elsif overlay_css != '' and image_url == ''
          assign bg_image_value = overlay_css
        elsif overlay_css == '' and image_url != ''
          assign bg_image_value = 'url(' | append: image_url | append: ')'
        endif
      -%}

      <div class="slideshow__slide grid__item grid--1-col slider__slide"
           id="Slide-{{ section.id }}-{{ forloop.index }}"
           {{ block.shopify_attributes }}
           role="group"
           aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
           aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
           tabindex="-1">

        <div class="premium-hero__backdrop" aria-hidden="true"
             style="{% if bg_image_value != '' %}background-image: {{ bg_image_value }};{% endif %}"></div>

        <div class="premium-hero__stage">
          <div class="premium-hero__graphic{% if block.settings.video != blank %} premium-hero__media--video{% endif %}{% if block.settings.slide_link != blank %} premium-hero__graphic--clickable{% endif %}">
            {%- if block.settings.video != blank -%}
              <video
                class="premium-hero__video"
                {% if block.settings.video_autoplay %}autoplay{% endif %}
                {% if block.settings.video_loop %}loop{% endif %}
                {% if block.settings.video_muted %}muted{% endif %}
                playsinline
                {% if block.settings.video_controls %}controls{% endif %}
                data-slide-video
              >
                {%- for source in block.settings.video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
                Your browser does not support the video tag.
              </video>
            {%- elsif block.settings.graphic_image -%}
              {%- liquid
                assign height = block.settings.graphic_image.width | divided_by: block.settings.graphic_image.aspect_ratio | round
                assign sizes = '100vw'
                assign widths = '375, 550, 750, 1100, 1500, 2000, 3000'
                assign fetch_priority = 'auto'
                if section.index == 1 and forloop.first
                  assign fetch_priority = 'high'
                endif
              -%}
              {{ block.settings.graphic_image
                | image_url: width: 3000
                | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths, fetchpriority: fetch_priority, class: 'premium-hero__image'
              }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg premium-hero__image' }}
            {%- endif -%}
          </div>
        </div>

        {%- if block.settings.slide_link != blank -%}
          <a href="{{ block.settings.slide_link }}" class="premium-hero__slide-link" aria-label="{{ block.settings.heading | default: 'View slide' | strip_html }}"></a>
        {%- endif -%}

        <div class="premium-hero__content banner__content banner__content--{{ block.settings.box_align }} page-width{% if block.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} scroll-trigger animate--slide-in{% endif %}">
          <div class="banner__box content-container content-container--full-width-mobile color-{{ block.settings.color_scheme }} gradient slideshow__text--{{ block.settings.text_alignment }} slideshow__text-mobile--{{ block.settings.text_alignment_mobile }}">
            {%- if block.settings.heading != blank -%}
              <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <div class="banner__text rte"><p>{{ block.settings.subheading }}</p></div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="banner__buttons">
                <a {% if block.settings.link %} href="{{ block.settings.link }}" {% else %} role="link" aria-disabled="true" {% endif %} class="button {% if block.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}">{{- block.settings.button_label | escape -}}</a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div class="slideshow__controls premium-hero__controls slider-buttons{% if section.settings.show_text_below %} slideshow__controls--border-radius-mobile{% endif %}">
      <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}" aria-controls="Slider-{{ section.id }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
      <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}" aria-controls="Slider-{{ section.id }}">
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}" aria-controls="Slider-{{ section.id }}">
        <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
      </button>
      {%- if section.settings.auto_rotate -%}
        <button type="button" class="slideshow__autoplay slider-button{% if section.settings.auto_rotate == false %} slideshow__autoplay--paused{% endif %}" aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}">
          <span class="svg-wrapper">{{- 'icon-pause.svg' | inline_asset_content -}}</span>
          <span class="svg-wrapper">{{- 'icon-play.svg' | inline_asset_content -}}</span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</slideshow-component>

{%- javascript -%}
  (() => {
    const root = document.currentScript.closest('slideshow-component');
    if (!root) return;

    // Badge close
    const close = root.querySelector('[data-badge-close]');
    if (close) {
      close.addEventListener('click', () => {
        const badge = root.querySelector('.premium-hero__badge');
        if (badge) badge.remove();
      });
    }

    // Video slide management
    const slider = root.querySelector('.slideshow');
    if (!slider) return;

    const videos = root.querySelectorAll('[data-slide-video]');
    if (videos.length > 0) {
      const handleSlideChange = () => {
        const activeSlide = slider.querySelector('.slider__slide[aria-hidden="false"]');
        videos.forEach(video => {
          const isInActive = activeSlide && activeSlide.contains(video);
          if (isInActive && video.hasAttribute('autoplay')) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      };

      const observer = new MutationObserver(handleSlideChange);
      slider.querySelectorAll('.slider__slide').forEach(slide => {
        observer.observe(slide, { attributes: true, attributeFilter: ['aria-hidden'] });
      });

      handleSlideChange();
    }
  })();
{%- endjavascript -%}

{% schema %}
{
  "name": "Premium Hero Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "full_bleed", "options": [
      { "value": "full_bleed", "label": "Full bleed" },
      { "value": "grid", "label": "Grid" }
    ]},
    { "type": "select", "id": "slide_height", "label": "Slide height", "default": "large", "options": [
      { "value": "adapt_image", "label": "Adapt to image" },
      { "value": "small", "label": "Small" },
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large" }
    ]},
    { "type": "select", "id": "slider_visual", "label": "Pagination style", "default": "numbers", "options": [
      { "value": "dots", "label": "Dots" },
      { "value": "counter", "label": "Counter" },
      { "value": "numbers", "label": "Numbers" }
    ]},
    { "type": "checkbox", "id": "auto_rotate", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "change_slides_speed", "min": 3, "max": 9, "step": 1, "unit": "s", "label": "Autoplay speed", "default": 5 },

    { "type": "header", "content": "Graphic card sizing" },
    { "type": "range", "id": "graphic_width_desktop", "min": 30, "max": 95, "step": 1, "unit": "%", "label": "Card width (desktop)", "default": 70 },
    { "type": "range", "id": "graphic_width_mobile",  "min": 70, "max": 100, "step": 1, "unit": "%", "label": "Card width (mobile)",  "default": 92 },
    { "type": "range", "id": "graphic_max_width", "min": 400, "max": 1600, "step": 20, "unit": "px", "label": "Card max width", "default": 1100 },
    { "type": "range", "id": "graphic_radius", "min": 0, "max": 48, "step": 1, "unit": "px", "label": "Card corner radius", "default": 20 },
    { "type": "range", "id": "stage_padding_desktop", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Stage padding (desktop)", "default": 64 },
    { "type": "range", "id": "stage_padding_mobile",  "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Stage padding (mobile)",  "default": 24 },
    { "type": "select", "id": "graphic_aspect_ratio", "label": "Card aspect ratio", "default": "16/9",
      "options": [
        { "value": "16/9", "label": "16:9" },
        { "value": "4/5",  "label": "4:5" },
        { "value": "1/1",  "label": "1:1" },
        { "value": "9/16", "label": "9:16" }
      ]
    },

    { "type": "text", "id": "accessibility_info", "label": "Accessibility label", "default": "Hero slider" },

    { "type": "header", "content": "Section fallback" },
    { "type": "image_picker", "id": "section_fallback_image", "label": "Fallback background image" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "header", "content": "Overlay & background" },
        { "type": "select", "id": "overlay_mode", "label": "Overlay mode", "default": "gradient",
          "options": [
            { "value": "gradient", "label": "Gradient" },
            { "value": "solid",    "label": "Solid color" },
            { "value": "none",     "label": "None" }
          ]
        },
        { "type": "color", "id": "overlay_color", "label": "Solid overlay color", "default": "#000000" },
        { "type": "color", "id": "gradient_from", "label": "Gradient — from", "default": "#1a0000" },
        { "type": "color", "id": "gradient_to",   "label": "Gradient — to",   "default": "#5a0a0a" },
        { "type": "range", "id": "gradient_angle", "min": 0, "max": 360, "step": 5, "unit": "deg", "label": "Gradient angle", "default": 0 },
        { "type": "image_picker", "id": "background_image", "label": "Background image for this slide" },

        { "type": "header", "content": "Graphic media (card)" },
        { "type": "video", "id": "video", "label": "Video (MP4)" },
        { "type": "image_picker", "id": "graphic_image", "label": "Graphic image (used if no video)" },

        { "type": "header", "content": "Video settings" },
