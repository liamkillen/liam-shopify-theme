<div id="shopify-section-product-previews" class="shopify-section">
  <style>
    .productPreviewContainer {
      background: #121313;
      padding: 60px;
      padding-bottom: 40px;
    }

    .productPreviewContainer h1, .productPreviewContainer h4 {
      text-align: center;
      margin: 0;
      padding: 0;
    }

    .productPreviewContainer h4 {
      text-transform: uppercase;
      color: #394856;
      font-weight: 100;
      margin-bottom: 10px;
    }

    .productPreviewContainer h1 {
      font-size: 36px;
      margin-bottom: 30px;
    }

    .productPreviewContainer > img {
      display: flex;
      margin: auto;
      margin-top: 40px;
    }

    .productPreviewSection {
      width: 1280px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      padding-top: 17.5px;
      margin: auto;
    }

    .productPreviewSection hr {
      margin: 10px 0;
      border-bottom: none;
    }

    .productPreviewSection > div {
      width: 100%;
      display: flex;
      flex-direction: row;
      margin-bottom: 10px;
    }

    .productPreviewSection h5 {
      text-align: center;
      margin: 0;
      font-weight: 100;
      margin-top: 5px;
      margin-bottom: 10px;
      color: #ffffff !important;
    }

    .productPreviewSection h6 {
      text-align: center;
      font-weight: 100;
      font-size: 12px;
    }

    .previewTeaserText {
      color: #3a3a3a !important;
      text-align: center;
      font-weight: 100;
      font-size: 12px;
      margin: 0 auto 17.5px auto !important;
    }

    .waveform {
      width: calc(100% - 50px);
      margin: 0;
      padding: 0;
      padding-left: 5px;
    }

    .waveformButton {
      padding: 0;
    }

    .productPreviewSection a {
      display: block;
      color: #bd0e0e;
      margin: 17.5px auto;
      padding: 0;
      font-size: 16px;
      font-weight: 600;
      text-align: center;
      width: fit-content;
    }

    .productPreviewSection a i {
      font-size: 13px;
      margin-left: 7px;
    }

    .productPreviewSection a:hover {
      color: #bd0e0e;
      text-decoration: underline;
    }

    .waveform div:empty {
      display: block;
    }

    @media only screen and (max-width: 1280px) {
      .productPreviewContainer {
        width: 100%;
      }

      .productPreviewSection {
        width: 100%;
      }

      .productPreviewContainer h1 {
        font-size: 32px;
      }
    }
  </style>

  <section class="productPreviewContainer">
    <div class="productPreviewSection">
      <div>
        <img id="playPauseButton" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform" class="waveform"><div></div></div>
      </div>
      <div>
        <img id="playPauseButton2" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform2" class="waveform"><div></div></div>
      </div>
      <div>
        <img id="playPauseButton3" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform3" class="waveform"><div></div></div> 
      </div>

      <h5>Bouncing Techno</h5>
      <h5>Weird Hats</h5>
      <h5>Synthy Perc</h5>

      <hr style="background-color:transparent;" />
          <hr style="background-color:transparent;" />
          <hr style="background-color:transparent;" />
      
      <div>
        <img id="playPauseButton4" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform4" class="waveform"><div></div></div>
      </div>
      <div>
        <img id="playPauseButton5" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform5" class="waveform"><div></div></div>
      </div>
      <div>
        <img id="playPauseButton6" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform6" class="waveform"><div></div></div>
      </div>

      <h5>Jeff's Groove</h5>
      <h5>Textured Bass</h5>
      <h5>Polyrhythmic Clap</h5>

    </div>

