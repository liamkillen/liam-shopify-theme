<div id="shopify-section-product-previews" class="shopify-section">
  <style>
    .productPreviewContainer {
      background: #121313;
      padding: 60px;
      padding-bottom: 40px;
    }

    .productPreviewContainer h1, .productPreviewContainer h4 {
      text-align: center;
      margin: 0;
      padding: 0;
    }

    .productPreviewContainer h4 {
      text-transform: uppercase;
      color: #394856;
      font-weight: 100;
      margin-bottom: 10px;
    }

    .productPreviewContainer h1 {
      font-size: 36px;
      margin-bottom: 30px;
    }

    .productPreviewContainer > img {
      display: flex;
      margin: auto;
      margin-top: 40px;
    }

    .productPreviewSection {
      width: 1280px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      padding-top: 17.5px;
      margin: auto;
    }

    .productPreviewSection hr {
      margin: 10px 0;
      border-bottom: none;
    }

    .productPreviewSection > div {
      width: 100%;
      display: flex;
      flex-direction: row;
      margin-bottom: 10px;
    }

    .productPreviewSection h5 {
      text-align: center;
      margin: 0;
      font-weight: 100;
      margin-top: 5px;
      margin-bottom: 10px;
      color: #ffffff !important;
    }

    .productPreviewSection h6 {
      text-align: center;
      font-weight: 100;
      font-size: 12px;
    }

    .previewTeaserText {
      color: #3a3a3a !important;
      text-align: center;
      font-weight: 100;
      font-size: 12px;
      margin: 0 auto 17.5px auto !important;
    }

    .waveform {
      width: calc(100% - 50px);
      margin: 0;
      padding: 0;
      padding-left: 5px;
    }

    .waveformButton {
      padding: 0;
    }

    .productPreviewSection a {
      display: block;
      color: #bd0e0e;
      margin: 17.5px auto;
      padding: 0;
      font-size: 16px;
      font-weight: 600;
      text-align: center;
      width: fit-content;
    }

    .productPreviewSection a i {
      font-size: 13px;
      margin-left: 7px;
    }

    .productPreviewSection a:hover {
      color: #bd0e0e;
      text-decoration: underline;
    }

    .waveform div:empty {
      display: block;
    }

    @media only screen and (max-width: 1280px) {
      .productPreviewContainer {
        width: 100%;
      }

      .productPreviewSection {
        width: 100%;
      }

      .productPreviewContainer h1 {
        font-size: 32px;
      }
    }
  </style>

  <section class="productPreviewContainer">
    <div class="productPreviewSection">
      <div>
        <img id="playPauseButton" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform" class="waveform"><div></div></div>
      </div>
      <div>
        <img id="playPauseButton2" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform2" class="waveform"><div></div></div>
      </div>
      <div>
        <img id="playPauseButton3" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform3" class="waveform"><div></div></div> 
      </div>

      <h5>Techno Pump</h5>
      <h5>Poly Techno</h5>
      <h5>Sounds like FM Techno</h5>

      <hr style="background-color:transparent;" />
          <hr style="background-color:transparent;" />
          <hr style="background-color:transparent;" />

    </div>

  </section>

<!-- Section 1 -->
<script type="module">
import WaveSurfer from 'https://unpkg.com/wavesurfer.js@7/dist/wavesurfer.esm.js';

const playSrc  = 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129';
const pauseSrc = 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/pause_white.png?v=1758032566';

window.allPlayers = [];

// create player 1
const wavesurfer   = WaveSurfer.create({ container: '#waveform',   cursorWidth: 0, height: 30, normalize: true, waveColor: '#D6D9DF', progressColor: '#9F96A6', url: 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/1-_Techno_Pump.wav?v=1749247238' });
window.allPlayers.push(wavesurfer);

// create player 2
const wavesurfer2  = WaveSurfer.create({ container: '#waveform2',  cursorWidth: 0, height: 30, normalize: true, waveColor: '#D6D9DF', progressColor: '#9F96A6', url: 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/2-_Poly_Techno.wav?v=1749247437' });
window.allPlayers.push(wavesurfer2);

// create player 3
const wavesurfer3  = WaveSurfer.create({ container: '#waveform3',  cursorWidth: 0, height: 30, normalize: true, waveColor: '#D6D9DF', progressColor: '#9F96A6', url: 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/3-_Sounds_like_FM_Techno.wav?v=1749247441' });
window.allPlayers.push(wavesurfer3);

// helper to bind button → player
function bindButton(id, player) {
  const btn = document.getElementById(id);
  if (!btn) return;
  btn.addEventListener('click', () => {
    window.allPlayers.forEach(p => { if (p !== player) p.pause() });
    player.playPause();
  });
  player.on('play',  () => btn.src = pauseSrc);
  player.on('pause', () => btn.src = playSrc);
}

bindButton('playPauseButton',  wavesurfer);
bindButton('playPauseButton2', wavesurfer2);
bindButton('playPauseButton3', wavesurfer3);
</script>


  {% schema %}
    {
      "name": "5vts - Previews",
      "settings": [],
      "presets": [
        {
          "name": "5vts - Previews",
          "category": "Custom",
          "blocks": []
        }
      ]
    }
  {% endschema %}
  
</div>

