<div class="download-section" style="text-align: center;">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.description }}</p>
  <a
    href="{{ section.settings.file_url }}"
    class="button"
    download
    style="display: inline-block; margin: 20px auto;"
  >
    {{ section.settings.button_text }}
  </a>
</div>

<style>
  .download-section {
    max-width: 800px;
    margin: 0 auto;
    padding: 30px;
  }
</style>

{% schema %}
{
  "name": "Download Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Download"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Click the button below to download your file"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Download Now"
    },
    {
      "type": "url",
      "id": "file_url",
      "label": "File URL"
    }
  ],
  "presets": [
    {
      "name": "Centered Download Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
