<div id="shopify-section-product-previews" class="shopify-section">
  <style>
    .productPreviewContainer {
      background: #121313;
      padding: 60px;
      padding-bottom: 40px;
    }

    .productPreviewContainer h1, .productPreviewContainer h4 {
      text-align: center;
      margin: 0;
      padding: 0;
    }

    .productPreviewContainer h4 {
      text-transform: uppercase;
      color: #394856;
      font-weight: 100;
      margin-bottom: 10px;
    }

    .productPreviewContainer h1 {
      font-size: 36px;
      margin-bottom: 30px;
    }

    .productPreviewContainer > img {
      display: flex;
      margin: auto;
      margin-top: 40px;
    }

    .productPreviewSection {
      width: 100%;
      max-width: 1280px;
      display: grid;
      grid-template-columns: repeat(3, 1fr); /* 3 columns */
      gap: 20px; /* optional spacing between columns */
      padding-top: 17.5px;
      margin: auto;
    }

    .productPreviewSection hr {
      margin: 10px 0;
      border-bottom: none;
    }

    .productPreviewSection > div {
      width: 100%;
      display: flex;
      flex-direction: row;
      margin-bottom: 10px;
    }

    .productPreviewSection h5 {
      text-align: center;
      margin: 0;
      font-weight: 100;
      margin-top: 5px;
      margin-bottom: 10px;
      color: #ffffff !important;
    }

    .productPreviewSection h6 {
      text-align: center;
      font-weight: 100;
      font-size: 12px;
    }

    .previewTeaserText {
      color: #3a3a3a !important;
      text-align: center;
      font-weight: 100;
      font-size: 12px;
      margin: 0 auto 17.5px auto !important;
    }

    .waveform {
      width: calc(100% - 50px);
      margin: 0;
      padding: 0;
      padding-left: 5px;
    }

    .waveformButton {
      padding: 0;
    }

    .productPreviewSection a {
      display: block;
      color: #bd0e0e;
      margin: 17.5px auto;
      padding: 0;
      font-size: 16px;
      font-weight: 600;
      text-align: center;
      width: fit-content;
    }

    .productPreviewSection a i {
      font-size: 13px;
      margin-left: 7px;
    }

    .productPreviewSection a:hover {
      color: #bd0e0e;
      text-decoration: underline;
    }

    .waveform div:empty {
      display: block;
    }

.productPreviewSection > div {
  display: flex;
  flex-direction: column;  /* stack play+waveform and h5 */
  align-items: center;
}

    .productPreviewSection h5 {
  margin-top: 10px;
}


    @media only screen and (max-width: 1280px) {
      .productPreviewContainer {
        width: 100%;
      }

      .productPreviewSection {
        width: 100%;
      }

      .productPreviewContainer h1 {
        font-size: 32px;
      }
    }

    @media only screen and (max-width: 600px) {
      .productPreviewSection {
        grid-template-columns: repeat(2, 1fr); /* 2 columns on mobile */
      }
    }
  </style>

