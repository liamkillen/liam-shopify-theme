<div id="shopify-section-product-previews" class="shopify-section">
  <style>
    .productPreviewContainer-b {
      background: #121313;
      padding: 60px;
      padding-bottom: 40px;
    }

    .productPreviewContainer-b h1, .productPreviewContainer-b h4 {
      text-align: center;
      margin: 0;
      padding: 0;
    }

    .productPreviewContainer-b h4 {
      text-transform: uppercase;
      color: #394856;
      font-weight: 100;
      margin-bottom: 10px;
    }

    .productPreviewContainer-b h1 {
      font-size: 36px;
      margin-bottom: 30px;
    }

    .productPreviewContainer-b > img {
      display: flex;
      margin: auto;
      margin-top: 40px;
    }

    .productPreviewSection-b {
      width: 100%;
      max-width: 1280px;
      display: grid;
      grid-template-columns: repeat(3, 1fr); /* columns */
      gap: 20px; /* optional spacing between columns */
      padding-top: 17.5px;
      margin: auto;
    }

    .productPreviewSection-b hr {
      margin: 10px 0;
      border-bottom: none;
    }

    .productPreviewSection-b > div {
      width: 100%;
      display: flex;
      flex-direction: row;
      margin-bottom: 10px;
    }

    .productPreviewSection-b h5 {
      text-align: center;
      margin: 0;
      font-weight: 100;
      margin-top: 5px;
      margin-bottom: 10px;
      color: #ffffff !important;
    }

    .productPreviewSection-b h6 {
      text-align: center;
      font-weight: 100;
      font-size: 12px;
    }

    .previewTeaserText {
      color: #3a3a3a !important;
      text-align: center;
      font-weight: 100;
      font-size: 12px;
      margin: 0 auto 17.5px auto !important;
    }

    .waveform {
      width: calc(100% - 50px);
      margin: 0;
      padding: 0;
      padding-left: 5px;
    }

    .waveformButton {
      padding: 0;
    }

    .productPreviewSection-b a {
      display: block;
      color: #bd0e0e;
      margin: 17.5px auto;
      padding: 0;
      font-size: 16px;
      font-weight: 600;
      text-align: center;
      width: fit-content;
    }

    .productPreviewSection-b a i {
      font-size: 13px;
      margin-left: 7px;
    }

    .productPreviewSection-b a:hover {
      color: #bd0e0e;
      text-decoration: underline;
    }

    .waveform div:empty {
      display: block;
    }

.productPreviewSection-b > div {
  display: flex;
  flex-direction: column;  /* stack play+waveform and h5 */
  align-items: center;
}

    .productPreviewSection-b h5 {
  margin-top: 10px;
}


    @media only screen and (max-width: 1280px) {
      .productPreviewContainer-b {
        width: 100%;
      }

      .productPreviewSection-b {
        width: 100%;
      }

      .productPreviewContainer-b h1 {
        font-size: 32px;
      }
    }

    @media only screen and (max-width: 600px) {
      .productPreviewSection-b {
        grid-template-columns: repeat(3, 1fr); /* 3 columns on mobile */
      }
    }
  </style>

<section class="productPreviewContainer-b">
  <div class="productPreviewSection-b">

    <div>
      <div style="display:flex; align-items:center; width:100%;">
        <img id="playPauseButton4" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform4" class="waveform"><div></div></div>
      </div>
      <h5>Dub-a-dub</h5>
    </div>

    <div>
      <div style="display:flex; align-items:center; width:100%;">
        <img id="playPauseButton6" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform6" class="waveform"><div></div></div>
      </div>
      <h5>Why so Dissonant?</h5>
    </div>


    <div>
      <div style="display:flex; align-items:center; width:100%;">
        <img id="playPauseButton5" class="waveformButton" src="https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129" width="30" height="30">
        <div id="waveform5" class="waveform"><div></div></div>
      </div>
      <h5>Ambient Techno</h5>
    </div>


  </div>
</section>


<script type="module">
import WaveSurfer from 'https://unpkg.com/wavesurfer.js@7/dist/wavesurfer.esm.js';

const playSrc  = 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/play_center_white.png?v=1757962129';
const pauseSrc = 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/pause_white.png?v=1758032566';

// create player 4
const wavesurfer4 = WaveSurfer.create({ container: '#waveform4', cursorWidth: 0, height: 30, normalize: true, waveColor: '#D6D9DF', progressColor: '#9F96A6', url: 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/1-_Dub-a-dub.wav?v=1749248716' });
window.allPlayers.push(wavesurfer4);

// create player 5
const wavesurfer5 = WaveSurfer.create({ container: '#waveform5', cursorWidth: 0, height: 30, normalize: true, waveColor: '#D6D9DF', progressColor: '#9F96A6', url: 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/3-_Ambient_Techno.wav?v=1749248702' });
window.allPlayers.push(wavesurfer5);

// create player 5
const wavesurfer6 = WaveSurfer.create({ container: '#waveform6', cursorWidth: 0, height: 30, normalize: true, waveColor: '#D6D9DF', progressColor: '#9F96A6', url: 'https://cdn.shopify.com/s/files/1/0904/5927/5539/files/2-_Why_so_Dissonant.wav?v=1749297225' });
window.allPlayers.push(wavesurfer6);  

function bindButton(id, player) {
  const btn = document.getElementById(id);
  if (!btn) return;
  btn.addEventListener('click', () => {
    window.allPlayers.forEach(p => { if (p !== player) p.pause() });
    player.playPause();
  });
  player.on('play',  () => btn.src = pauseSrc);
  player.on('pause', () => btn.src = playSrc);
}

bindButton('playPauseButton4', wavesurfer4);
bindButton('playPauseButton5', wavesurfer5);
bindButton('playPauseButton6', wavesurfer6);  
</script>


  {% schema %}
    {
      "name": "5v - Product Previews",
      "settings": [],
      "presets": [
        {
          "name": "5v - Product Previews",
          "category": "Custom",
          "blocks": []
        }
      ]
    }
  {% endschema %}
  
</div>

